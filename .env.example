# ---------------------------------------------------------------------------
# SlimX Reader — environment configuration
# Copy to .env and adjust. Everything runs locally by default; nothing leaves
# this machine unless you explicitly enable cloud providers.
# ---------------------------------------------------------------------------

# --- Local dev ports (used by ./scripts/dev.sh) ---
# Change these if 3000/8000 are already in use (e.g. another app is running).
# dev.sh reads this file, so setting them here is all you need.
READER_WEB_PORT=3000
READER_API_PORT=8000

# --- Reader API ---
# Where the API stores SQLite metadata + document files + exports.
READER_DATA_DIR=./data
# Max upload size (MiB). Large PDFs are streamed to disk, not held in memory.
READER_MAX_DOCUMENT_UPLOAD_MB=50

# --- Frontend ---
# Where the web app calls the API (and streams PDF bytes). Leave unset to let dev.sh derive it
# from READER_API_PORT (http://localhost:<READER_API_PORT>). Set it only for a custom/remote API.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- SlimX-RAG (knowledge engine) ---
# SlimX Reader talks to SlimX-RAG (github.com/slimx-ai/SlimX-RAG) as an HTTP
# service; it never reimplements indexing/retrieval. When ENABLE_RAG is false or
# the service is unreachable, indexing parks as "waiting_for_rag" and the app
# stays fully usable for reading/annotation.
READER_ENABLE_RAG=true
READER_SLIMX_RAG_URL=http://localhost:8080
# Bearer token sent to SlimX-RAG (only needed if the service enforces one).
READER_SLIMX_RAG_AUTH_TOKEN=

# --- Model execution (SlimX) ---
# Local-first defaults. Ollama needs no key. See docs/local-models.md.
READER_DEFAULT_PROVIDER=ollama
READER_DEFAULT_MODEL=llama3.2:3b
READER_OLLAMA_BASE_URL=http://localhost:11434
# OpenAI-compatible local server (vLLM, LM Studio, llama.cpp, Ollama /v1, ...).
READER_OAI_BASE_URL=
READER_OAI_API_KEY=EMPTY

# --- Privacy ---
# Cloud providers are OFF by default. When false, the API blocks any call that
# would send a prompt, document chunk, or evidence to a non-local endpoint.
READER_ALLOW_CLOUD_PROVIDERS=false
# Cloud provider keys (only used when READER_ALLOW_CLOUD_PROVIDERS=true).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
